{
  "name": "3vtechworks-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Monorepo with React+TypeScript+AntD Frontend and Node.js+Express+MongoDB Backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,cyan.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "monorepo",
    "react",
    "typescript",
    "antd",
    "express",
    "nodejs",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
